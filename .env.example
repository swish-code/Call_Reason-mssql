# ---------------------------------------------------------------
# Call_Reason — SQL Server edition
# Copy this file to `.env` and fill in the real values.
# ---------------------------------------------------------------

# Port the web application listens on (IT-specified for this deployment).
PORT=6004

# --- Microsoft SQL Server connection -----------------------------
# Host or IP of the SQL Server instance.
SQLSERVER_HOST=192.168.204.250
# Database created by sql/schema.sql.
SQLSERVER_DB=Call_Reason
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=change-me
# Default SQL Server port; change if the instance listens elsewhere.
SQLSERVER_PORT=1433

# Set to "false" only if the server presents a certificate your host trusts.
# Company instances typically use a self-signed certificate, so this stays true.
SQLSERVER_TRUST_CERT=true
# Set to "true" to require an encrypted connection.
SQLSERVER_ENCRYPT=false

# Optional tuning
# SQLSERVER_POOL_MAX=10
# SQLSERVER_REQUEST_TIMEOUT=60000

# --- Application ------------------------------------------------
# Secret used to sign login tokens. MUST be changed for a real deployment.
JWT_SECRET=change-me-to-a-long-random-string
